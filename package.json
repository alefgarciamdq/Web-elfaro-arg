{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "prebuild": "node scripts/fetch-reviews.mjs",
    "build": "npm run clean && node scripts/sanitize-content.mjs && npm run generate-sitemap && vite-react-ssg build && node scripts/post-build-fix.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/patch-vite-react-ssg.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.546.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-helmet-async": "3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "vite": "^6.2.0",
    "vite-react-ssg": "^0.9.1-beta.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "beasties": "^0.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
