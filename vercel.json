{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/recursos/como-ayudar-familiar-adicciones-valencia",
      "destination": "/recursos/familias-adicciones-valencia-como-acompanar-sin-destruirse",
      "permanent": true
    },
    {
      "source": "/recursos/cambios-conducta-adolescentes-valencia",
      "destination": "/recursos/mi-hijo-ha-cambiado-adolescencia-orientacion-valencia",
      "permanent": true
    },
    {
      "source": "/recursos/ansiedad-en-valencia-cuando-pedir-ayuda",
      "destination": "/cuando-pedir-ayuda-psicologica-valencia",
      "permanent": true
    },
    {
      "source": "/recursos/adolescentes-pantallas-aislamiento-valencia",
      "destination": "/pantallas-ninos-cuando-preocuparse",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "headers": [
    {
      "source": "/cita",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/static-loader-data-manifest-(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
